# Copie ce fichier en .env et adapte. Ne commite JAMAIS le .env (secrets).

# --- Broker Mosquitto dedie de la stack (service "mqtt" du docker-compose.yml) -
# Ce broker est independant de Home Assistant et impose une authentification.
MQTT_HOTE=127.0.0.1
MQTT_PORT=1883
MQTT_UTILISATEUR=ia
MQTT_MOT_DE_PASSE=change-moi-ia
# Certificat de la CA locale (vide = pas de TLS)
MQTT_CA=
TOPIC_CAPTEURS=station/station1/capteurs
PREFIXE_DISCOVERY=homeassistant

# --- Vidéo ---------------------------------------------------------------------
# Flux webcam relayé par go2rtc (FFmpeg -> MediaMTX -> go2rtc). Vide = webcam USB en direct.
SOURCE_VIDEO=rtsp://127.0.0.1:8554/usb

# --- API de l'équipe dev (exigence du sujet : POST /api/v1/alerts) ---------------
# En attendant l'API : python outils/fausse_api.py, qui écoute sur ce port.
API_ALERTES=http://127.0.0.1:8000/api/v1/alerts
API_CA=
API_JETON=
# Cible de l'architecture v2, derrière le reverse proxy HTTPS :
# API_ALERTES=https://192.168.10.1/api/v1/alerts
# API_CA=/chemin/vers/ca.crt
