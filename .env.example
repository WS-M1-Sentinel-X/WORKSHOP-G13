# Public hostname or IP used by WireGuard clients.
# Leave unset to let the container detect it automatically.
WIREGUARD_SERVERURL=auto

# Dedicated Mosquitto broker credentials. Change these values before deployment.
MQTT_BROKER_PASSWORD_ESP8266=change-moi-esp8266
MQTT_BROKER_PASSWORD_IA=change-moi-ia
MQTT_BROKER_PASSWORD_HOMEASSISTANT=change-moi-homeassistant

# Nom du flux webcam dans go2rtc (camera USB locale sur Ubuntu).
CAMERA_STREAM=camera_usb

# API des devs qui reçoit les alertes IA (vide = alertes seulement journalisées).
API_ALERTES=

# Nombre de mesures normales pour l'apprentissage de l'IA anomalies (1200 = 20 min à 1 mesure/s).
IA_APPRENTISSAGE=1200
